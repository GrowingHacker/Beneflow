{
  "ConnectionStrings": {
    "Default": "Data Source=localhost\\SQLEXPRESS;Initial Catalog=BeneflowDb;Persist Security Info=True;User ID=sa;Password=<your-password>;Pooling=False;MultipleActiveResultSets=False;Encrypt=False;TrustServerCertificate=False;Application Name=Beneflow.Api"
  },
  "Backup": {
    "Dir": "backups"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Jwt": {
    "Secret": "<at-least-32-bytes-random-secret>",
    "Issuer": "Beneflow",
    "Audience": "BeneflowClient",
    "ExpireMinutes": 720
  },
  "Barcode": {
    "ApiZeroKey": ""
  },
  "AllowedHosts": "*",
  "Security": {
    "AesKey": "<base64-32-bytes-random-key>"
  }
}
