<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- 按 Spec 目标为 .NET 8；RollForward=Major 使其在本机仅装有 .NET 10 运行时时也能运行，
         而部署到装有 .NET 8 运行时的环境时仍优先使用 .NET 8。 -->
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Beneflow.Api</RootNamespace>
    <AssemblyName>Beneflow.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- 日志：按天滚动文件日志 -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.2" />
    <!-- JWT Bearer 认证 -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.2" />
    <!-- 数据访问：EF Core 8 + SQL Server（Code First） -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
